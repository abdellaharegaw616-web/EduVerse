# EduVerse API Environment Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://eduverse_admin:eduverse_dev_password@localhost:5432/eduverse_db?schema=public"

# Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="dev_access_secret_key_eduverse_32chars_min"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_key_eduverse_32chars_min"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

