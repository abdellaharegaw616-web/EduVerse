// EduVerse — Prisma Database Schema
// PostgreSQL 16+ with UUIDs, Referential Integrity, and Optimized Indexes

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  TEACHER
  INDEPENDENT_INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum SubmissionStatus {
  PENDING
  GRADED
  RETURNED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  TEXT
  PDF_RESOURCE
  EXTERNAL_RESOURCE
  ATTACHMENT
}

// -------------------------------------------------------------
// 1. IDENTITY & USER PROFILE DOMAIN
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  isEmailVerified Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1:1 Profile
  profile UserProfile?

  // Institutional Affiliations
  institutionMemberships InstitutionMember[]

  // Author & Teacher Relations
  authoredCourses Course[]      @relation("CourseAuthor")
  taughtClasses   Class[]       @relation("ClassTeacher")
  announcements   Announcement[] @relation("AnnouncementAuthor")

  // Learning & Progress Relations
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  submissions      AssignmentSubmission[]
  certificates     Certificate[]
  reviews          Review[]
  achievements     UserAchievement[]
  notifications    Notification[]

  // Security, Verification & Audit
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         Invitation[]             @relation("SentInvitations")
  auditLogs               AuditLog[]

  @@index([role])
  @@index([email])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?  @db.Text
  avatarUrl   String?
  phoneNumber String?
  timezone    String   @default("Africa/Addis_Ababa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// -------------------------------------------------------------
// 2. INSTITUTION & ACADEMIC STRUCTURE DOMAIN
// -------------------------------------------------------------

model Institution {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  domain       String?  @unique
  contactEmail String
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       InstitutionMember[]
  departments   Department[]
  courses       Course[]
  announcements Announcement[]
  invitations   Invitation[]

  @@index([slug])
}

model Invitation {
  id            String       @id @default(uuid())
  email         String
  role          Role
  tokenHash     String       @unique
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([email])
  @@index([tokenHash])
  @@index([institutionId])
}

model InstitutionMember {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role        @default(STUDENT)
  joinedAt      DateTime    @default(now())

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  courses Course[]
  classes Class[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Class {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User       @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  name         String
  academicYear String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  enrollments Enrollment[]

  @@index([departmentId])
  @@index([teacherId])
}

// -------------------------------------------------------------
// 3. CURRICULUM & CONTENT DOMAIN
// -------------------------------------------------------------

model CourseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id                 String            @id @default(uuid())
  title              String
  slug               String            @unique
  description        String            @db.Text
  thumbnailUrl       String?
  language           String            @default("English")
  difficulty         CourseDifficulty  @default(BEGINNER)
  learningObjectives String[]          @default([])
  prerequisites      String[]          @default([])
  estimatedHours     Int               @default(10)
  status             CourseStatus      @default(DRAFT)
  authorId           String
  author             User              @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  institutionId      String?
  institution        Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  categoryId         String?
  category           CourseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sections      CourseSection[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  reviews       Review[]
  announcements Announcement[]

  @@index([status])
  @@index([authorId])
  @@index([institutionId])
  @@index([categoryId])
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@index([courseId, sortOrder])
}

model Lesson {
  id              String        @id @default(uuid())
  sectionId       String
  section         CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  content         String        @db.Text
  videoUrl        String?
  durationMinutes Int           @default(10)
  sortOrder       Int           @default(0)
  type            LessonType    @default(VIDEO)
  isFreePreview   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  resources  LessonResource[]
  progress   LessonProgress[]
  quiz       Quiz?
  assignment Assignment?

  @@unique([sectionId, slug])
  @@index([sectionId])
  @@index([sectionId, sortOrder])
}

model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileType  String   @default("PDF")
  fileSize  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([lessonId])
}

// -------------------------------------------------------------
// 4. LEARNING, PROGRESS & ASSESSMENT DOMAIN
// -------------------------------------------------------------

model Enrollment {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classId            String?
  class              Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  progressPercentage Float     @default(0.0)
  enrolledAt         DateTime  @default(now())
  completedAt        DateTime?

  lessonProgress LessonProgress[]
  certificate    Certificate?
  quizAttempts   QuizAttempt[]
  submissions    AssignmentSubmission[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(true)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

model Quiz {
  id           String     @id @default(uuid())
  lessonId     String     @unique
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int        @default(70)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String       @db.Text
  type         QuestionType @default(MULTIPLE_CHOICE)
  sortOrder    Int          @default(0)
  points       Int          @default(1)
  createdAt    DateTime     @default(now())

  options AnswerOption[]

  @@index([quizId])
}

model AnswerOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

model QuizAttempt {
  id           String     @id @default(uuid())
  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  attemptedAt  DateTime   @default(now())

  @@index([quizId])
  @@index([enrollmentId])
}

model Assignment {
  id           String     @id @default(uuid())
  lessonId     String     @unique
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String     @db.Text
  maxScore     Int        @default(100)
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?          @db.Text
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  grade        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  @@index([assignmentId])
  @@index([enrollmentId])
}

// -------------------------------------------------------------
// 5. CERTIFICATES, ENGAGEMENT & GAMIFICATION
// -------------------------------------------------------------

model Certificate {
  id               String      @id @default(uuid())
  verificationCode String      @unique
  enrollmentId     String      @unique
  enrollment       Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId         String
  course           Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  issuedAt         DateTime    @default(now())

  @@index([verificationCode])
  @@index([userId])
  @@index([courseId])
}

model Review {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([courseId])
}

model Announcement {
  id            String       @id @default(uuid())
  title         String
  content       String       @db.Text
  authorId      String
  author        User         @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  courseId      String?
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([courseId])
  @@index([institutionId])
}

model Achievement {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  badgeIcon   String
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// -------------------------------------------------------------
// 6. SYSTEM NOTIFICATIONS & AUDIT LOGGING
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

