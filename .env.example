# EduVerse Monorepo Environment Variables
# Copy this file to individual apps as required (.env.local for apps/web, .env for apps/api)

# API & Gateway
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Web
NEXT_PUBLIC_APP_NAME="EduVerse"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Database (PostgreSQL)
DATABASE_URL="postgresql://eduverse_admin:eduverse_dev_password@localhost:5432/eduverse_db?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="dev_access_secret_key_eduverse_32chars_min"
JWT_REFRESH_SECRET="dev_refresh_secret_key_eduverse_32chars_min"

